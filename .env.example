# Base de données — Postgres partout (T04).
#
# En développement : le serveur PGlite local, lancé par `pnpm db:local` dans un
# terminal à part. Absente, cette valeur est le défaut du code.
#
# En production, Supabase :
#   - l'application vise le pooler en mode **transaction** (port 6543) :
#       postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<région>.pooler.supabase.com:6543/postgres
#   - `pnpm db:migrate` passe de préférence par le mode **session** (port 5432)
#     sur le même hôte :
#       postgresql://postgres.<ref>:<mot-de-passe>@aws-0-<région>.pooler.supabase.com:5432/postgres
#     Le mode transaction (6543) fonctionne aussi — le migrateur joue tout dans
#     une seule transaction — et dépanne quand le réseau filtre le 5432.
#   La connexion directe (db.<ref>.supabase.co) n'existe qu'en IPv6 : éviter
#   depuis un poste sans IPv6 (WSL2 notamment).
DATABASE_URL="postgres://postgres:postgres@127.0.0.1:5433/postgres"

# Autorité de certification de la base, au format PEM.
#
# Une base hors de la machine se joint en TLS **vérifié** — l'équivalent de
# `sslmode=verify-full` : chaîne de certification et nom d'hôte. Une autorité
# publique passe avec le magasin de confiance de Node, sans rien renseigner.
# Supabase fournit la sienne dans le tableau de bord (Project Settings →
# Database → SSL Configuration → Download certificate) : la coller ici, entre
# guillemets, si la connexion est refusée faute d'autorité reconnue
# (`SELF_SIGNED_CERT_IN_CHAIN`, `UNABLE_TO_VERIFY_LEAF_SIGNATURE`). Les retours
# à la ligne peuvent s'écrire `\n`. Renseignée, seule cette autorité est
# acceptée ; vide, un certificat inconnu est refusé — c'est le défaut sûr.
# Sans effet sur le serveur PGlite local, qui ne parle pas TLS.
DATABASE_CA_CERT=""

# `pnpm db:reset`, `db:rollback` et `db:seed` refusent une base hors de cette
# machine : sur Supabase, ils annuleraient les migrations et injecteraient les
# comptes de démonstration. Poser `1` lève le refus pour une exécution — à ne
# jamais laisser dans un `.env` : `DATABASE_ALLOW_RESET=1 pnpm db:rollback`.
# DATABASE_ALLOW_RESET=""

# Secret de session (cookie httpOnly). Générer avec : openssl rand -hex 32
NUXT_SESSION_SECRET=""

# URL publique, utilisée pour les liens d'invitation et les reçus signés
NUXT_PUBLIC_SITE_URL="http://localhost:3000"

# Back-office — numéros autorisés, séparés par des virgules.
#
# Le statut d'administrateur vient de cette liste, jamais de la base de
# données : une compromission de la base ne donne pas les droits
# d'administration. Vide ou absente, le back-office est inaccessible — c'est le
# défaut sûr.
#
# Après l'avoir renseignée : `pnpm db:admin` crée les comptes correspondants.
NUXT_ADMIN_PHONES=""

# Web Push — sans ces clés, les notifications restent en base et consultables
# dans l'application ; rien n'échoue. Générer une paire avec :
#   npx web-push generate-vapid-keys
NUXT_VAPID_PUBLIC_KEY=""
NUXT_VAPID_PRIVATE_KEY=""
NUXT_VAPID_SUBJECT="mailto:contact@tontine.ci"

# Règlement de l'abonnement — l'application n'encaisse rien.
#
# Le président envoie le forfait par mobile money sur ce numéro, en citant la
# référence affichée dans son écran d'abonnement, puis envoie la capture au
# numéro WhatsApp de contact. Un administrateur rapproche et pose le palier
# depuis le back-office. Vides, l'écran renvoie vers l'adresse de contact de
# l'éditeur (shared/constants/editeur.ts).
NUXT_PUBLIC_ABONNEMENT_REGLEMENT_OPERATEUR="wave"
NUXT_PUBLIC_ABONNEMENT_REGLEMENT_NUMERO=""
NUXT_PUBLIC_ABONNEMENT_REGLEMENT_TITULAIRE=""
NUXT_PUBLIC_ABONNEMENT_REGLEMENT_CONTACT=""

# Envoi des e-mails — confirmation d'inscription, code oublié, avis de
# changement. C'est l'e-mail qui prouve qu'un compte appartient à quelqu'un :
# sans lui, personne ne finit son inscription.
#
# `log` écrit le message (et le lien) dans les journaux : admis en
# développement et en test, refusé en production. `resend` passe par l'API
# HTTP de Resend (https://resend.com — palier gratuit suffisant pour des
# confirmations) : la clé, et une adresse d'expédition sur un domaine vérifié
# chez eux. Brancher un autre fournisseur se fait dans
# server/services/email.ts, en une fonction.
NUXT_EMAIL_PROVIDER="log"
NUXT_EMAIL_RESEND_API_KEY=""
NUXT_EMAIL_FROM="eTontine <no-reply@tontine.ci>"

# Limitation des essais de connexion par adresse IP : active en production,
# levée en développement et en test (la suite de bout en bout ouvre des
# dizaines de sessions depuis la même adresse). Poser `1` pour la forcer.
# NUXT_LIMITE_IP=""
