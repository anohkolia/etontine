{
  "name": "tontine-ci",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "nuxt dev",
    "build": "nuxt build && node scripts/verifier-bundle.ts",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck && tsc -p tsconfig.tests.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:rollback": "node server/db/cli.ts rollback",
    "db:seed": "node server/db/seed.ts",
    "db:reset": "node server/db/cli.ts rollback && drizzle-kit migrate && node server/db/seed.ts",
    "verify:bundle": "node scripts/verifier-bundle.ts",
    "lighthouse": "lhci autorun",
    "dev:admin": "nuxt dev admin --port 3001 --dotenv ../.env",
    "build:admin": "nuxt build admin --dotenv ../.env",
    "db:admin": "node server/db/cli.ts admin"
  },
  "dependencies": {
    "@nuxt/icon": "2.5.1",
    "@pinia/nuxt": "^1.0.2",
    "@primevue/nuxt-module": "4.5.5",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.2",
    "exceljs": "^4.4.0",
    "nuxt": "4.5.2",
    "pdfkit": "^0.20.1",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "primevue": "4.5.5",
    "qrcode": "^1.5.4",
    "web-push": "^3.6.7",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@iconify-json/lucide": "1.2.126",
    "@lhci/cli": "^0.15.1",
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.1.0",
    "@playwright/test": "1.62.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.13.3",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@vite-pwa/nuxt": "1.1.1",
    "@vue/test-utils": "2.4.11",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "h3": "1.15.11",
    "happy-dom": "20.11.8",
    "tailwindcss": "4.3.3",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.9.3",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
