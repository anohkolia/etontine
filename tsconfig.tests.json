{
  // Nuxt génère quatre contextes (app, server, shared, node) et aucun ne couvre
  // `tests/` ni les fichiers de configuration de la racine. Sans ce contexte
  // supplémentaire, un test peut casser sans que `pnpm typecheck` s'en aperçoive.
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Les scripts de `server/` et leurs tests importent avec l'extension `.ts` :
    // c'est ce qui les rend exécutables par Node sans transpilation préalable
    // (`pnpm db:seed`, `pnpm db:rollback`). Nuxt active déjà ce réglage dans ses
    // contextes `server` et `shared`.
    "allowImportingTsExtensions": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "#shared/*": ["./shared/*"],
      "~~/*": ["./*"]
    }
  },
  "include": [
    "tests/**/*.ts",
    "vitest.config.ts",
    "playwright.config.ts",
    "drizzle.config.ts"
  ]
}
